parameters:
    level: 8
    paths:
        - src
        - tests
    symfony:
        containerXmlPath: var/cache/dev/App_KernelDevDebugContainer.xml
    ignoreErrors:
        # The watch command loops until the user stops it
        -
            identifier: while.alwaysTrue
            path: src/Infrastructure/Command/AssetsWatchCommand.php
        -
            identifier: deadCode.unreachable
            path: src/Infrastructure/Command/AssetsWatchCommand.php
